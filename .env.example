# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+psycopg2://pulsegrid:pulsegrid_dev_pw@localhost:5432/pulsegrid

# How often the background simulator generates a new batch of readings (seconds)
SIMULATOR_INTERVAL_SECONDS=2.0

# How many sensors are sampled per simulator tick
SIMULATOR_BATCH_SIZE=25

MODEL_PATH=app/ml/isolation_forest.joblib
SCALER_PATH=app/ml/scaler.joblib
